{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"/path/to/autolinkingbrain/.venv/bin/python\" \"/path/to/autolinkingbrain/.cursor/hooks/session_mem0_bootstrap.py\"",
        "timeout": 45,
        "env": {
          "MEM0_TELEMETRY": "false"
        }
      }
    ],
    "afterAgentResponse": [
      {
        "command": "\"/path/to/autolinkingbrain/.venv/bin/python\" \"/path/to/autolinkingbrain/.cursor/hooks/mem0_autolog_after_response.py\"",
        "timeout": 180,
        "env": {
          "MEM0_TELEMETRY": "false",
          "MEM0_AUTOLOG": "1",
          "MEM0_AUTOLOG_STRICT": "1",
          "MEM0_AUTOLOG_USE_OLLAMA": "0",
          "MEM0_AUTOLOG_OLLAMA_FALLBACK": "0",
          "MEM0_AUTOLOG_TARGET": "project",
          "MEM0_AUTOLOG_BACKEND": "sqlite",
          "_comment": "Do not set MEM0_AUTOLOG_ALLOW_MEM0=1 unless migrating legacy autolog into Chroma"
        }
      }
    ],
    "postToolUse": [
      {
        "command": "\"/path/to/autolinkingbrain/.venv/bin/python\" \"/path/to/autolinkingbrain/.cursor/hooks/mem0_autolog_post_tool.py\"",
        "timeout": 45,
        "env": {
          "MEM0_TELEMETRY": "false",
          "MEM0_TOOLLOG": "0",
          "MEM0_TOOLLOG_TARGET": "project",
          "MEM0_AUTOLOG_BACKEND": "sqlite",
          "_comment": "Do not set MEM0_AUTOLOG_ALLOW_MEM0=1 unless migrating legacy autolog into Chroma"
        }
      }
    ]
  }
}
