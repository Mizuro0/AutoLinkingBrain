# Optional discovery / routing overrides (copy vars into mcp.json "env" or shell profile).
# All keys are optional — defaults use structure only (.git, package.json, pyproject.toml, …).

# --- CodeGraph repo discovery (brain.py codegraph) ---

# Semicolon-separated folder names to skip entirely (default: none)
# CODEGRAPH_EXCLUDE_NAMES=python;.venv

# Path segments to skip (any match in full path)
# CODEGRAPH_EXCLUDE_PATHS=node_modules;.git

# Sibling folders to deep-scan for nested repos (by folder name).
# When unset: only folders with 2+ child git/project dirs are scanned (structural).
# CODEGRAPH_CONTAINER_NAMES=workspace;monorepo

# When duplicate repo folder names exist, demote paths containing these segments
# CODEGRAPH_DEPRIORITIZE_PATHS=archive;copy

# When duplicate repo folder names exist, prefer paths containing these segments
# CODEGRAPH_PREFER_PATHS=codes;projects

# Monorepo / workspace root (semicolon-separated)
# CODEGRAPH_WORKSPACE=/path/to/monorepo

# Extra repo paths (semicolon-separated)
# CODEGRAPH_REPOS=/path/to/other-repo

# Scan sibling folders next to AutoLinkingBrain install (default: 1)
# CODEGRAPH_SCAN_SIBLINGS=1

# Max directory depth when walking workspace (default: 2, max 4)
# CODEGRAPH_SCAN_DEPTH=2

# --- Mem0 MCP slug warnings ---

# Warn if resolved slug matches these names (default: none — no warnings)
# Example for Windows profile mis-cwd: user;desktop;documents;downloads
# MEM0_SUSPICIOUS_SLUGS=

# Force slug when roots/list unavailable
# MEM0_PROJECT_SLUG=my-repo
